# All generated build and package staging files stay below build/.
set(RuntimeRoot "@PROJECT_SOURCE_DIR@/bin/${CMAKE_INSTALL_CONFIG_NAME}")
if(NOT EXISTS "${RuntimeRoot}/OffHangerWoTOfflineVehicleEditor.exe")
	message(FATAL_ERROR "Build the selected editor configuration before packaging.")
endif()
file(GLOB RuntimeFiles "${RuntimeRoot}/*")
foreach(RuntimeFile IN LISTS RuntimeFiles)
	if(NOT IS_DIRECTORY "${RuntimeFile}")
		get_filename_component(Name "${RuntimeFile}" NAME)
		if(Name MATCHES "\\.(dll|pri|winmd|exe)$" AND NOT Name STREQUAL "OffHangerWoTOfflineVehicleEditorTests.exe")
			file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}" TYPE FILE FILES "${RuntimeFile}")
		endif()
	endif()
endforeach()
# NuGet supplies machine-local package folders in its generated asset manifest.
# Discover notices there rather than baking a developer profile into the project.
set(Assets "@CMAKE_BINARY_DIR@/obj/project.assets.json")
if(EXISTS "${Assets}")
	file(READ "${Assets}" AssetJson)
	string(JSON FolderCount LENGTH "${AssetJson}" packageFolders)
	string(JSON LibraryCount LENGTH "${AssetJson}" libraries)
	math(EXPR LastFolder "${FolderCount} - 1")
	math(EXPR LastLibrary "${LibraryCount} - 1")
	foreach(LibraryIndex RANGE 0 ${LastLibrary})
		string(JSON Library MEMBER "${AssetJson}" libraries ${LibraryIndex})
		string(TOLOWER "${Library}" PackagePath)
		string(REPLACE "/" "-" NoticeFolder "${Library}")
		foreach(FolderIndex RANGE 0 ${LastFolder})
			string(JSON Folder MEMBER "${AssetJson}" packageFolders ${FolderIndex})
			file(GLOB Notices "${Folder}/${PackagePath}/LICENSE*" "${Folder}/${PackagePath}/License*"
				"${Folder}/${PackagePath}/NOTICE*" "${Folder}/${PackagePath}/*ThirdPartyNotices*"
				"${Folder}/${PackagePath}/*.nuspec")
			if(Notices)
				file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/Licenses/NuGet/${NoticeFolder}"
					TYPE FILE FILES ${Notices})
				break()
			endif()
		endforeach()
	endforeach()
endif()
foreach(Folder Config Microsoft.UI.Xaml runtimes en-us zh-CN)
	if(EXISTS "${RuntimeRoot}/${Folder}")
		file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}" TYPE DIRECTORY FILES "${RuntimeRoot}/${Folder}")
	endif()
endforeach()
